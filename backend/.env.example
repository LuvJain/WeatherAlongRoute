# WeatherPlanning Application Environment Variables Example
# Copy this file to .env and adjust the values accordingly

# Environment Configuration
APP_ENVIRONMENT=development  # Options: development, testing, production
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# API Keys
OPENWEATHER_API_KEY=your_api_key_here

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Safety mechanism to prevent accidental production deployments
# Set this value to "production-ready" when deploying to production
# ENVIRONMENT_VALIDATION=production-ready