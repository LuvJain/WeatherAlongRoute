# WeatherPlanning Application Environment Variables
# Copy this file to .env and adjust values for your local environment

# ===== Environment Configuration =====
APP_ENVIRONMENT=development  # Options: development, testing, production
DEBUG=true

# ===== Server Configuration =====
HOST=0.0.0.0
PORT=8000

# ===== Database Configuration =====
DATABASE_URL=postgresql://postgres:postgres@db:5432/weatherplanning
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=weatherplanning
POSTGRES_HOST=db  # localhost for local development, db for Docker

# ===== API Keys =====
OPENWEATHER_API_KEY=your_api_key_here

# ===== CORS Configuration =====
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ===== Logging Configuration =====
LOG_LEVEL=debug  # Options: debug, info, warning, error, critical
LOG_FORMAT=text  # Options: text, json
LOG_TO_FILE=true
LOG_FILE_ROTATION=5  # Number of files to keep
LOG_FILE_MAX_SIZE=10  # Size in MB

# ===== Security Configuration =====
SECRET_KEY=your_secret_key_for_tokens
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== Safety mechanism to prevent accidental production deployments =====
# Set this value to "production-ready" only when deploying to production
# ENVIRONMENT_VALIDATION=production-ready