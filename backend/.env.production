# Production Environment Configuration

# Environment Configuration
APP_ENVIRONMENT=production
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=8000

# API Keys
OPENWEATHER_API_KEY=your_production_api_key_here

# CORS Configuration - Restrict to specific domains in production
ALLOWED_ORIGINS=https://weather-planning.example.com,https://api.weather-planning.example.com

# Safety mechanism to prevent accidental production deployments
# Uncomment and set correctly for production deployment
# ENVIRONMENT_VALIDATION=production-ready