# Example environment settings
# Copy this file to .env and fill in your own values

# Enable source maps for debugging
GENERATE_SOURCEMAP=true

# React optimizations
REACT_APP_OPTIMIZATION=false

# Source maps for debugging
INLINE_RUNTIME_CHUNK=false

# Service worker registration for offline support
REACT_APP_REGISTER_SERVICE_WORKER=false

# API URL for development
REACT_APP_API_URL=http://localhost:3000

# Google Places API key (required)
# Get your key from Google Cloud Console: https://console.cloud.google.com/
REACT_APP_GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# OpenWeatherMap API configuration
# Get your API key from: https://openweathermap.org/api
REACT_APP_WEATHER_API_KEY=your_openweathermap_api_key_here
REACT_APP_WEATHER_API_URL=https://api.openweathermap.org/data/2.5
REACT_APP_WEATHER_API_UNITS=metric  # Options: metric (Celsius), imperial (Fahrenheit), standard (Kelvin)

# Other environment variables
NODE_ENV=development
PORT=3000